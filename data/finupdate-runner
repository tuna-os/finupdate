#!/bin/sh
# finupdate-runner — runs as root via a single pkexec elevation.
# Drives the four update modules in sequence, emitting structured markers
# that the Rust orchestrator parses into ModuleStarted/ModuleFinished events.
#
# Marker protocol:
#   ===MODULE:<name>===              module starting
#   ===MODULE:<name>:done:<rc>===    module finished with exit code
#   ===MODULE:<name>:skipped===      module skipped (tool not present)
#   ===DONE===                       all modules finished

set -u

emit() { printf '===%s===\n' "$1"; }

# Tracks whether any module exited non-zero and non-77 (77 = "nothing to
# update", not a failure). The script's own exit code reflects this at the
# end so a caller that only checks the process exit status (rather than
# parsing the marker stream) still sees a failed run as a failure.
RUNNER_HAD_FAILURE=0

# Emits a module's done marker and records the exit code toward
# RUNNER_HAD_FAILURE. $1 = module name, $2 = module exit code.
emit_done() {
    module="$1"
    code="$2"
    emit "MODULE:${module}:done:${code}"
    if [ "$code" != "0" ] && [ "$code" != "77" ]; then
        RUNNER_HAD_FAILURE=1
    fi
}

# When FINUPDATE_SYSTEM_ONLY=1 (set by the "Include app updates" toggle in
# Preferences), skip flatpak / brew / distrobox and only refresh the system
# image. The marker stream still emits the per-module headers as `skipped`
# so the orchestrator's state machine doesn't have to special-case this.
SYSTEM_ONLY="${FINUPDATE_SYSTEM_ONLY:-0}"

# ── System (bootc / rpm-ostree) ───────────────────────────────────────────────
emit MODULE:system
if command -v bootc >/dev/null 2>&1; then
    bootc upgrade
    emit_done system "$?"
elif command -v rpm-ostree >/dev/null 2>&1; then
    rpm-ostree upgrade
    emit_done system "$?"
else
    echo "system: neither bootc nor rpm-ostree found — skipping"
    emit MODULE:system:skipped
fi

# ── Flatpak ───────────────────────────────────────────────────────────────────
emit MODULE:flatpak
if [ "$SYSTEM_ONLY" = "1" ]; then
    echo "flatpak: skipped (system-only mode)"
    emit MODULE:flatpak:skipped
elif command -v flatpak >/dev/null 2>&1; then
    flatpak update -y --noninteractive
    emit_done flatpak "$?"
else
    echo "flatpak: not found — skipping"
    emit MODULE:flatpak:skipped
fi

# ── Homebrew ──────────────────────────────────────────────────────────────────
emit MODULE:brew
if [ "$SYSTEM_ONLY" = "1" ]; then
    echo "brew: skipped (system-only mode)"
    emit MODULE:brew:skipped
else
    BREW_BIN="${FINUPDATE_TEST_BREW_BIN:-}"
    if [ -z "$BREW_BIN" ]; then
        for candidate in \
            /home/linuxbrew/.linuxbrew/bin/brew \
            /usr/local/bin/brew \
            /opt/homebrew/bin/brew; do
            if [ -x "$candidate" ]; then
                BREW_BIN="$candidate"
                break
            fi
        done
    fi

    if [ -n "$BREW_BIN" ]; then
        # brew must run as the invoking human user, not root. Prefer pkexec's
        # own provenance (PKEXEC_UID / PKEXEC_USER, set by polkit) before
        # falling back to the "first UID ≥ 1000" heuristic — on multi-user
        # systems the heuristic can target the wrong account.
        BREW_USER=""
        if [ -n "${PKEXEC_UID:-}" ] && getent passwd "${PKEXEC_UID}" >/dev/null 2>&1; then
            BREW_USER="$(getent passwd "${PKEXEC_UID}" | cut -d: -f1)"
        elif [ -n "${PKEXEC_USER:-}" ]; then
            BREW_USER="${PKEXEC_USER}"
        else
            BREW_USER=$(getent passwd | awk -F: '$3 >= 1000 && $3 < 65534 { print $1; exit }')
        fi
        if [ -n "$BREW_USER" ]; then
            su - "$BREW_USER" -c "$BREW_BIN upgrade --quiet"
            emit_done brew "$?"
        else
            echo "brew: could not determine non-root user — skipping"
            emit MODULE:brew:skipped
        fi
    else
        echo "brew: not found — skipping"
        emit MODULE:brew:skipped
    fi
fi

# ── Distrobox ─────────────────────────────────────────────────────────────────
emit MODULE:distrobox
if [ "$SYSTEM_ONLY" = "1" ]; then
    echo "distrobox: skipped (system-only mode)"
    emit MODULE:distrobox:skipped
elif command -v distrobox >/dev/null 2>&1; then
    distrobox upgrade --all
    emit_done distrobox "$?"
else
    echo "distrobox: not found — skipping"
    emit MODULE:distrobox:skipped
fi

emit DONE

# Aggregate exit code: any module failure makes the whole run fail, even
# though each module already reports its own outcome through the marker
# stream. A caller relying only on this process's exit status (rather than
# parsing markers) must not observe success when a module failed.
if [ "$RUNNER_HAD_FAILURE" = "1" ]; then
    exit 1
fi
